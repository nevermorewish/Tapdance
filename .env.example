# The Huanxing API address is also editable on the login screen.
VITE_NEWAPI_BASE_URL="https://api.huanxing.ai"

# Local bridge used for NewAPI login/register and Electron persistence.
SEEDANCE_BRIDGE_PORT=3210
VITE_SEEDANCE_BRIDGE_TARGET="http://127.0.0.1:3210"

# Optional. Runtime state for the local bridge. Keep this out of Git.
RENREN_APP_DATA_DIR="./local_data"
